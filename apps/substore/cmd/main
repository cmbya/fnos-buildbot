#!/bin/bash
set -eu
export PATH="/var/apps/nodejs_v24/target/bin:$PATH"
: "${TRIM_APPDEST:?missing application directory}"
: "${TRIM_PKGVAR:?missing data directory}"
port="${port:-21678}"
[[ "$port" =~ ^[0-9]{1,5}$ ]] && (( 10#$port >= 1 && 10#$port <= 65535 )) || { printf 'Invalid port\n' >&2; exit 1; }
export SUB_STORE_BACKEND_MERGE=true
export SUB_STORE_FRONTEND_PATH="${TRIM_APPDEST}/www"
export SUB_STORE_DATA_BASE_PATH="$TRIM_PKGVAR"
export SUB_STORE_BACKEND_API_PORT="$port"
export SUB_STORE_FRONTEND_BACKEND_PATH=/path
PID_FILE="$TRIM_PKGVAR/app.pid"
LOG_FILE="$TRIM_PKGVAR/info.log"
SERVER="$TRIM_APPDEST/server/sub-store.bundle.js"

running() {
    [[ -r "$PID_FILE" ]] || return 1
    read -r pid < "$PID_FILE" || [[ -n "${pid:-}" ]] || return 1
    [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null || return 1
    [[ -r "/proc/$pid/cmdline" ]] || return 1
    local arg
    while IFS= read -r -d '' arg; do
        [[ "$arg" == "$SERVER" ]] && return 0
    done < "/proc/$pid/cmdline"
    return 1
}
stop_process() {
    if running; then
        kill -TERM "$pid"
        for ((i=0; i<10; i++)); do
            running || break
            sleep 1
        done
        if running; then kill -KILL "$pid"; fi
    fi
    rm -f -- "$PID_FILE"
}
case "${1:-}" in
start)
    running && exit 0
    command -v node >/dev/null || { printf 'Node.js 24 dependency is missing\n' >&2; exit 1; }
    node -e 'if (Number(process.versions.node.split(".")[0]) < 24) process.exit(1)'
    mkdir -p -- "$TRIM_PKGVAR"
    cd "$TRIM_PKGVAR"
    node "$SERVER" >> "$LOG_FILE" 2>&1 &
    pid=$!
    printf '%s\n' "$pid" > "$PID_FILE"
    for ((i=0; i<30; i++)); do
        if ! kill -0 "$pid" 2>/dev/null; then
            printf 'Sub-Store exited before ready; see %s\n' "$LOG_FILE" >&2
            rm -f -- "$PID_FILE"
            exit 1
        fi
        if node -e 'const http=require("node:http");const r=http.get({host:"127.0.0.1",port:process.argv[1],path:"/path/api/utils/env",timeout:800},s=>{s.resume();process.exit(s.statusCode===200?0:1)});r.on("timeout",()=>r.destroy());r.on("error",()=>process.exit(1))' "$port"; then exit 0; fi
        sleep 1
    done
    stop_process
    printf 'Sub-Store readiness timed out; see %s\n' "$LOG_FILE" >&2
    exit 1
    ;;
stop) stop_process ;;
status) running && exit 0; exit 3 ;;
*) exit 1 ;;
esac
