#!/bin/bash
set -u
export PATH="/var/apps/python312/target/bin:/var/apps/nodejs_v22/target/bin:/usr/local/bin:/usr/bin:/bin:$PATH"
RUNTIME="${TRIM_PKGVAR}/native-runtime"
DEFAULT_DOWNLOADS="${TRIM_DATA_SHARE_PATHS%%:*}"
LOG="${TRIM_PKGVAR}/upgrade.log"
mkdir -p "$RUNTIME" "${TRIM_PKGETC}"

# native1 did not have this file. Preserve the old default share on the first
# native1 -> native2 upgrade; later configuration changes can switch it.
if [ ! -s "${TRIM_PKGETC}/recording_path.conf" ]; then
  printf '%s\n' "$DEFAULT_DOWNLOADS" > "${TRIM_PKGETC}/recording_path.conf"
fi

if ! "${TRIM_APPDEST}/native/bundle/python/bin/python3.12" "${TRIM_APPDEST}/native/offline.py" \
  --runtime "$RUNTIME" --downloads "$DEFAULT_DOWNLOADS" --port "${TRIM_SERVICE_PORT:-6006}" >> "$LOG" 2>&1; then
  echo "StreamCap 原生运行环境升级失败；旧配置不会删除。请查看 ${LOG}。" > "${TRIM_TEMP_LOGFILE}"
  exit 1
fi
exit 0
