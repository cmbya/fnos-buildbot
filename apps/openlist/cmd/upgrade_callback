#!/bin/bash
set -u
export PATH="/var/apps/python312/target/bin:/usr/local/bin:/usr/bin:/bin:$PATH"
RUNTIME="${TRIM_PKGVAR}/runtime"
DATA_DIR="${TRIM_PKGVAR}/data"
LOG="${TRIM_PKGVAR}/upgrade.log"
VERSION="${TRIM_APPVER%%-*}"
mkdir -p "$RUNTIME" "$DATA_DIR"
if ! /var/apps/python312/target/bin/python3 "${TRIM_APPDEST}/native/bootstrap.py" \
  --runtime "$RUNTIME" --data "$DATA_DIR" --version "$VERSION" >> "$LOG" 2>&1; then
  {
    echo "OpenList 升级程序准备失败，原有 data 没有删除。"
    echo "upgrade.log 最后 30 行："
    echo "----------------"
    tail -n 30 "$LOG" 2>/dev/null || true
  } > "${TRIM_TEMP_LOGFILE}"
  exit 1
fi
exit 0
