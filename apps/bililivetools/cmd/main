#!/bin/bash
set -u

RUNTIME="${TRIM_PKGVAR}/native-runtime"
FRONT_PID="${TRIM_PKGVAR}/bililivetools.front.pid"
TIME_PID="${TRIM_PKGVAR}/bililivetools.time.pid"
BACK_PID="${TRIM_PKGVAR}/bililivetools.back.pid"

FRONT_PORT="${TRIM_SERVICE_PORT:-3000}"
BACK_PORT="18010"
VIDEO_DIR="${TRIM_DATA_SHARE_PATHS%%:*}"

LOG_DIR="${VIDEO_DIR}/biliLive-tools-Logs"
FRONT_LOG="${LOG_DIR}/webui.log"
TIME_LOG="${LOG_DIR}/time-monitor.log"
BACK_LOG="${LOG_DIR}/backend.log"
MAIN_LOG="${LOG_DIR}/main.log"

export PATH="$RUNTIME/node/bin:/var/apps/python312/target/bin:$RUNTIME/bin:/usr/local/bin:/usr/bin:/bin:$PATH"
export LD_LIBRARY_PATH="$RUNTIME/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=1
export NODE_ENV=production
export TZ=Asia/Shanghai
export HOME="$RUNTIME/home"
export BAIDUPCS_GO_CONFIG_DIR="$RUNTIME/data"
export ALIYUNPAN_CONFIG_DIR="$RUNTIME/data"
export BILILIVE_TOOLS_DELETE_DIRS="$VIDEO_DIR"

pid_alive() {
  local f="$1" p=""
  [ -f "$f" ] || return 1
  p="$(head -n1 "$f" 2>/dev/null | tr -d '[:space:]')"
  [ -n "$p" ] && kill -0 "$p" 2>/dev/null
}

clean_pid() {
  pid_alive "$1" || rm -f "$1"
}

is_running() {
  clean_pid "$BACK_PID"
  clean_pid "$TIME_PID"
  clean_pid "$FRONT_PID"

  pid_alive "$BACK_PID"     && pid_alive "$TIME_PID"     && pid_alive "$FRONT_PID"
}

rotate_log() {
  local f="$1"
  [ -f "$f" ] || return 0
  local size
  size="$(wc -c < "$f" 2>/dev/null || echo 0)"
  if [ "${size:-0}" -ge 10485760 ]; then
    rm -f "${f}.1"
    mv "$f" "${f}.1"
  fi
}

prepare_logs() {
  mkdir -p "$LOG_DIR" || return 1
  rotate_log "$BACK_LOG"
  rotate_log "$FRONT_LOG"
  rotate_log "$TIME_LOG"
  rotate_log "$MAIN_LOG"
  return 0
}

repair_video_link() {
  [ -n "$VIDEO_DIR" ] || return 1
  mkdir -p "$VIDEO_DIR" "$RUNTIME" || return 1

  if [ -L "$RUNTIME/video" ]; then
    local cur
    cur="$(readlink "$RUNTIME/video" 2>/dev/null || true)"
    if [ "$cur" != "$VIDEO_DIR" ]; then
      rm -f "$RUNTIME/video"
      ln -s "$VIDEO_DIR" "$RUNTIME/video"
    fi
  elif [ ! -e "$RUNTIME/video" ]; then
    ln -s "$VIDEO_DIR" "$RUNTIME/video"
  fi
}

configure_visible_log() {
  python3 - "$RUNTIME/config.json" "$MAIN_LOG" <<'PY'
from pathlib import Path
import json
import sys

path = Path(sys.argv[1])
log_path = sys.argv[2]

cfg = json.loads(path.read_text(encoding="utf-8"))
cfg["logPath"] = log_path
path.write_text(
    json.dumps(cfg, ensure_ascii=False, indent=2) + "\n",
    encoding="utf-8",
)

print(
    "[fnOS native8 log] application logPath=" + log_path,
    flush=True,
)
PY
}

apply_time_patch() {
  python3 - "$RUNTIME/backend" <<'PY'
from __future__ import annotations

from pathlib import Path
import re
import subprocess
import sys

backend = Path(sys.argv[1]).resolve()

# ============================================================
# fnOS native5: bundle-aware target discovery
#
# npm 的 bililive-cli 发行包可能把 liveManager 打进一个大的
# index-*.cjs，而不是保留 @bililive-tools/manager/lib/manager.js。
# ============================================================
search_roots = [
    backend / "node_modules" / "bililive-cli" / "lib",
    backend / "node_modules" / "@bililive-tools" / "manager" / "lib",
]

all_candidates = []

for base in search_roots:
    if not base.exists():
        continue

    for p in base.rglob("*"):
        if not p.is_file():
            continue

        if p.suffix.lower() not in {".js", ".cjs", ".mjs"}:
            continue

        try:
            sample = p.read_text(
                encoding="utf-8",
                errors="ignore",
            )
        except OSError:
            continue

        score = 0

        # Strongest indicators: native2 successfully patched this exact bundle.
        if "// fnOS native2: monitor-time guard" in sample:
            score += 1000

        if "[fnOS native2 time] startRecord" in sample:
            score += 800

        # Retrying a partially patched package.
        if "// fnOS native3: strict monitor-time helper" in sample:
            score += 1200

        if "// fnOS native4: monitor-window enter re-arm" in sample:
            score += 1200

        # Upstream manager structural signals.
        if "checkLiveStatusAndRecord" in sample:
            score += 120

        if "ignoreDataLimit" in sample:
            score += 120

        if "isBetweenTimeRange" in sample:
            score += 100

        if "handleBatchQuery" in sample:
            score += 80

        if "disableAutoCheck" in sample:
            score += 40

        if "recordHandle" in sample:
            score += 40

        if score > 0:
            all_candidates.append((score, p, sample))

if not all_candidates:
    searched = ", ".join(str(p) for p in search_roots)
    raise SystemExit(
        "[fnOS native8 time] ERROR: "
        "没有找到包含录制管理逻辑的 JS/CJS bundle；"
        f"已扫描：{searched}"
    )

all_candidates.sort(
    key=lambda item: (
        item[0],
        item[1].stat().st_size,
    ),
    reverse=True,
)

best_score, manager_path, text = all_candidates[0]

required_signals = [
    "checkLiveStatusAndRecord",
    "ignoreDataLimit",
]

missing_signals = [
    signal for signal in required_signals
    if signal not in text
]

if missing_signals:
    details = "; ".join(
        f"{score}:{path.name}"
        for score, path, _ in all_candidates[:5]
    )
    raise SystemExit(
        "[fnOS native8 time] ERROR: "
        "候选 bundle 缺少关键录制特征 "
        f"{missing_signals}; candidates={details}"
    )

print(
    "[fnOS native8 time] target bundle: "
    f"{manager_path.name} score={best_score} "
    f"size={manager_path.stat().st_size}",
    flush=True,
)
print(
    "[fnOS native8 time] target path: "
    f"{manager_path}",
    flush=True,
)

HELPER_MARKER = "// fnOS native3: strict monitor-time helper"
START_MARKER = "// fnOS native3: strict startRecord guard"
BATCH_MARKER = "// fnOS native3: strict Bilibili batch gate"

changed = False

def block(lines):
    return "\n".join(lines)

# ------------------------------------------------------------
# 1) Strict Beijing-time helper.
# ------------------------------------------------------------
if HELPER_MARKER not in text:
    anchor = "const recorders = [];"
    if anchor not in text:
        raise SystemExit(
            "[fnOS native3 time] ERROR: "
            "找不到 const recorders = []，上游结构已变化"
        )

    helper = block([
        "// fnOS native3: strict monitor-time helper",
        "    const fnosTimeToSeconds = (value) => {",
        '        if (typeof value !== "string") return null;',
        r'        const match = value.trim().match(/^(\d{1,2}):(\d{2})(?::(\d{2}))?$/);',
        "        if (!match) return null;",
        "",
        "        const h = Number(match[1]);",
        "        const m = Number(match[2]);",
        '        const s = Number(match[3] ?? "0");',
        "",
        "        if (",
        "            !Number.isInteger(h) ||",
        "            !Number.isInteger(m) ||",
        "            !Number.isInteger(s) ||",
        "            h < 0 || h > 23 ||",
        "            m < 0 || m > 59 ||",
        "            s < 0 || s > 59",
        "        ) {",
        "            return null;",
        "        }",
        "",
        "        return h * 3600 + m * 60 + s;",
        "    };",
        "",
        "    const fnosBeijingNowSeconds = () => {",
        "        const parts = new Intl.DateTimeFormat(",
        '            "en-GB",',
        "            {",
        '                timeZone: "Asia/Shanghai",',
        '                hour: "2-digit",',
        '                minute: "2-digit",',
        '                second: "2-digit",',
        '                hourCycle: "h23",',
        "            },",
        "        ).formatToParts(new Date());",
        "",
        "        const obj = Object.fromEntries(",
        "            parts.map((item) => [item.type, item.value]),",
        "        );",
        "",
        "        return (",
        "            Number(obj.hour) * 3600 +",
        "            Number(obj.minute) * 60 +",
        "            Number(obj.second)",
        "        );",
        "    };",
        "",
        "    const fnosBeijingNowText = () => {",
        "        return new Intl.DateTimeFormat(",
        '            "zh-CN",',
        "            {",
        '                timeZone: "Asia/Shanghai",',
        '                year: "numeric",',
        '                month: "2-digit",',
        '                day: "2-digit",',
        '                hour: "2-digit",',
        '                minute: "2-digit",',
        '                second: "2-digit",',
        '                hourCycle: "h23",',
        "            },",
        "        ).format(new Date());",
        "    };",
        "",
        "    const fnosIsTimeAllowed = (range) => {",
        "        // No configured time window means all day.",
        "        " + "if (!Array.isArray(range) || range.length !== 2) {",
        "            return true;",
        "        }",
        "",
        "        const startRaw = range[0];",
        "        const endRaw = range[1];",
        "",
        "        if (",
        "            startRaw == null ||",
        "            endRaw == null ||",
        '            String(startRaw).trim() === "" ||',
        '            String(endRaw).trim() === ""',
        "        ) {",
        "            return true;",
        "        }",
        "",
        "        const start = fnosTimeToSeconds(String(startRaw));",
        "        const end = fnosTimeToSeconds(String(endRaw));",
        "",
        "        // Configured but malformed -> fail closed.",
        "        if (start == null || end == null) {",
        "            console.error(",
        "                `[fnOS native3 time] INVALID handleTime=` +",
        "                `${JSON.stringify(range)} => BLOCK`,",
        "            );",
        "            return false;",
        "        }",
        "",
        "        // Same start/end = all day.",
        "        if (start === end) return true;",
        "",
        "        const now = fnosBeijingNowSeconds();",
        "",
        "        if (start < end) {",
        "            return now >= start && now <= end;",
        "        }",
        "",
        "        // Cross midnight, e.g. 22:00 -> 02:00.",
        "        return now >= start || now <= end;",
        "    };",
        "",
    ]) + "\n    "

    text = text.replace(anchor, helper + anchor, 1)
    changed = True

# ------------------------------------------------------------
# 2) startRecord strict guard and default no-bypass.
# ------------------------------------------------------------
native3_start_block = block([
    "// fnOS native3: strict startRecord guard",
    "            const fnosTimeAllowed = fnosIsTimeAllowed(recorder.handleTime);",
    "            console.log(",
    "                `[fnOS native3 time] startRecord ` +",
    "                `id=${id} now=${fnosBeijingNowText()} ` +",
    "                `handleTime=${JSON.stringify(recorder.handleTime)} ` +",
    "                `ignoreDataLimit=${ignoreDataLimit} ` +",
    "                `allowed=${fnosTimeAllowed}`,",
    "            );",
    "",
    "            if (!ignoreDataLimit && !fnosTimeAllowed) {",
    "                console.log(",
    "                    `[fnOS native3 time] BLOCK startRecord outside monitor window ` +",
    "                    `id=${id}`,",
    "                );",
    "                return;",
    "            }",
])

if START_MARKER not in text:
    native2_marker = "// fnOS native2: monitor-time guard"
    if native2_marker in text:
        start = text.index(native2_marker)
        # End at the next "await recorder.checkLiveStatusAndRecord" to safely
        # replace only native2's guard block.
        call_pos = text.find("await recorder.checkLiveStatusAndRecord", start)
        if call_pos < 0:
            raise SystemExit(
                "[fnOS native3 time] ERROR: "
                "native2 startRecord block found but call anchor missing"
            )
        text = text[:start] + native3_start_block + "\n            " + text[call_pos:]
        changed = True
    else:
        original_start_re = re.compile(
            r"if\s*\(\s*!ignoreDataLimit\s*&&\s*"
            r"isBetweenTimeRange\(\s*recorder\.handleTime\s*\)"
            r"\s*\)\s*return\s*;?"
        )
        if not original_start_re.search(text):
            raise SystemExit(
                "[fnOS native3 time] ERROR: 找不到 startRecord 时间判断"
            )
        text = original_start_re.sub(native3_start_block, text, count=1)
        changed = True

# Change default bypass true -> false.
default_re = re.compile(
    r"const\s*\{\s*ignoreDataLimit\s*=\s*true\s*\}\s*=\s*iOpts\s*;"
)
if default_re.search(text):
    text = default_re.sub(
        "const { ignoreDataLimit = false } = iOpts;",
        text,
        count=1,
    )
    changed = True

# ------------------------------------------------------------
# 3) Bilibili batch strict filter.
# ------------------------------------------------------------
if "fnOS native2: Bilibili batch monitor-time guard" in text:
    text = text.replace(
        "// fnOS native2: Bilibili batch monitor-time guard",
        BATCH_MARKER,
        1,
    )
    # Limit replacement to the first native2 helper use in the batch block.
    batch_pos = text.find(BATCH_MARKER)
    allowed_pos = text.find(
        "const allowed = isBetweenTimeRange(r.handleTime);",
        batch_pos,
    )
    if allowed_pos >= 0:
        old = "const allowed = isBetweenTimeRange(r.handleTime);"
        text = (
            text[:allowed_pos]
            + "const allowed = fnosIsTimeAllowed(r.handleTime);"
            + text[allowed_pos + len(old):]
        )
    text = text.replace(
        "[fnOS native2 time] SKIP Bilibili batch",
        "[fnOS native3 time] SKIP Bilibili batch",
        1,
    )
    changed = True

elif BATCH_MARKER not in text:
    handle_pos = text.find("const handleBatchQuery")
    need_pos = text.find("const needCheckRecorders")
    if handle_pos < 0 or need_pos < 0 or need_pos <= handle_pos:
        raise SystemExit(
            "[fnOS native3 time] ERROR: "
            "找不到 handleBatchQuery / needCheckRecorders"
        )

    head = text[handle_pos:need_pos]
    batch_pattern = re.compile(
        r'(\.filter\(\s*\(r\)\s*=>\s*'
        r'r\.providerId\s*===\s*["\']Bilibili["\']\s*\))'
    )
    matches = list(batch_pattern.finditer(head))
    if len(matches) != 1:
        raise SystemExit(
            "[fnOS native3 time] ERROR: "
            f"Bilibili batch filter count={len(matches)}"
        )

    batch_replacement = block([
        r"\1",
        "                // fnOS native3: strict Bilibili batch gate",
        "                .filter((r) => {",
        "                    const allowed = fnosIsTimeAllowed(r.handleTime);",
        "                    if (!allowed) {",
        "                        console.log(",
        "                            `[fnOS native3 time] SKIP Bilibili batch ` +",
        "                            `channel=${r.channelId} ` +",
        "                            `now=${fnosBeijingNowText()} ` +",
        "                            `handleTime=${JSON.stringify(r.handleTime)}`,",
        "                        );",
        "                    }",
        "                    return allowed;",
        "                })",
    ])
    patched_head = batch_pattern.sub(batch_replacement, head, count=1)
    text = text[:handle_pos] + patched_head + text[need_pos:]
    changed = True

# ------------------------------------------------------------
# 4) Normal auto-check strict filter.
# ------------------------------------------------------------
normal_old = ".filter((r) => isBetweenTimeRange(r.handleTime))"
if normal_old in text:
    text = text.replace(
        normal_old,
        ".filter((r) => fnosIsTimeAllowed(r.handleTime))",
        1,
    )
    changed = True

# ------------------------------------------------------------
# 5) Optional immediate-retry time guard.
#
# Upstream recordRetryImmediately can call checkLiveStatusAndRecord()
# directly after an interrupted record. Patch it only when the compiled
# shape is recognizable. Missing this OPTIONAL anchor must never block startup.
# ------------------------------------------------------------
RETRY_MARKER = "// fnOS native6: immediate-retry time guard"

if RETRY_MARKER not in text:
    retry_re = re.compile(
        r'(setTimeout\(\s*\(\)\s*=>\s*\{\s*)'
        r'(recorder\.checkLiveStatusAndRecord\(\s*\{)',
        re.S,
    )

    retry_matches = list(retry_re.finditer(text))

    if retry_matches:
        replacement = (
            r'\1'
            '// fnOS native6: immediate-retry time guard\n'
            'if (!fnosIsTimeAllowed(recorder.handleTime)) {\n'
            '    console.log(\n'
            '        `[fnOS native8 time] BLOCK immediate retry ` +\n'
            '        `channel=${recorder.channelId} ` +\n'
            '        `now=${fnosBeijingNowText()} ` +\n'
            '        `handleTime=${JSON.stringify(recorder.handleTime)}`,\n'
            '    );\n'
            '    return;\n'
            '}\n'
            r'\2'
        )

        text = retry_re.sub(replacement, text, count=1)
        changed = True
        print("[fnOS native8 time] immediate-retry guard = patched", flush=True)
    else:
        print(
            "[fnOS native8 time] immediate-retry guard = optional pattern not found; continue",
            flush=True,
        )

# ------------------------------------------------------------
# Verification
# ------------------------------------------------------------
for marker in [HELPER_MARKER, START_MARKER]:
    if marker not in text:
        raise SystemExit(
            f"[fnOS native3 time] ERROR: missing marker {marker}"
        )

if "ignoreDataLimit = true" in text:
    raise SystemExit(
        "[fnOS native3 time] ERROR: "
        "ignoreDataLimit default true still exists"
    )

if changed:
    manager_path.write_text(text, encoding="utf-8")
    print(
        "[fnOS native8 time] patched: " + str(manager_path),
        flush=True,
    )
else:
    print(
        "[fnOS native8 time] patch already present",
        flush=True,
    )

print("[fnOS native8 time] strict Beijing clock = OK", flush=True)
print("[fnOS native8 time] startRecord guard = OK", flush=True)

check = subprocess.run(
    ["node", "--check", str(manager_path)],
    stdout=subprocess.PIPE,
    stderr=subprocess.STDOUT,
    text=True,
)

if check.returncode != 0:
    raise SystemExit(
        "[fnOS native8 time] ERROR: patched bundle failed node --check:\n"
        + check.stdout[-4000:]
    )

print("[fnOS native8 time] node --check = OK", flush=True)
PY
}

prepare_time_sidecar() {
  cat > "$RUNTIME/fnos_time_monitor.js" <<'NODE'
"use strict";

const BASE = process.env.FNOS_BACKEND_URL || "http://127.0.0.1:18010";
const PASSKEY = process.env.BILILIVE_TOOLS_PASSKEY || "";
const POLL_MS = 5000;
const RETRY_MS = 10000;
const MAX_ATTEMPTS = 3;

const states = new Map();
const detailLogged = new Set();

let busy = false;
let lastListCount = null;

function stamp() {
  return new Date().toLocaleString(
    "zh-CN",
    {
      timeZone: "Asia/Shanghai",
      hour12: false,
    },
  );
}

function log(message) {
  console.log(`${stamp()} [fnOS native8 window] ${message}`);
}

function timeToSeconds(value) {
  if (typeof value !== "string") return null;
  const m = value.trim().match(/^(\d{1,2}):(\d{2})(?::(\d{2}))?$/);
  if (!m) return null;

  const h = Number(m[1]);
  const min = Number(m[2]);
  const sec = Number(m[3] || "0");

  if (
    !Number.isInteger(h) ||
    !Number.isInteger(min) ||
    !Number.isInteger(sec) ||
    h < 0 || h > 23 ||
    min < 0 || min > 59 ||
    sec < 0 || sec > 59
  ) {
    return null;
  }

  return h * 3600 + min * 60 + sec;
}

function beijingNowSeconds() {
  const parts = new Intl.DateTimeFormat(
    "en-GB",
    {
      timeZone: "Asia/Shanghai",
      hour: "2-digit",
      minute: "2-digit",
      second: "2-digit",
      hourCycle: "h23",
    },
  ).formatToParts(new Date());

  const obj = Object.fromEntries(
    parts.map((item) => [item.type, item.value]),
  );

  return (
    Number(obj.hour) * 3600 +
    Number(obj.minute) * 60 +
    Number(obj.second)
  );
}

function timeAllowed(range) {
  if (!Array.isArray(range) || range.length !== 2) {
    return null;
  }

  const start = timeToSeconds(String(range[0] ?? ""));
  const end = timeToSeconds(String(range[1] ?? ""));

  if (start == null || end == null) {
    return false;
  }

  if (start === end) {
    return true;
  }

  const now = beijingNowSeconds();

  if (start < end) {
    return now >= start && now <= end;
  }

  return now >= start || now <= end;
}

async function api(pathname, options = {}) {
  const response = await fetch(
    BASE + pathname,
    {
      ...options,
      headers: {
        Authorization: PASSKEY,
        ...(options.headers || {}),
      },
      signal: AbortSignal.timeout(8000),
    },
  );

  const raw = await response.text();
  let body = raw;

  if (raw) {
    try {
      body = JSON.parse(raw);
    } catch (_) {
      // keep raw text
    }
  }

  if (!response.ok) {
    throw new Error(
      `${options.method || "GET"} ${pathname} -> ` +
      `${response.status}: ${raw.slice(0, 500)}`,
    );
  }

  return body;
}

function unwrap(value) {
  let current = value;

  for (let i = 0; i < 8; i += 1) {
    if (
      current == null ||
      typeof current !== "object" ||
      Array.isArray(current)
    ) {
      break;
    }

    // fnOS native7:
    // biliLive-tools 3.20.0 REST envelope:
    // { payload: { data: ... } }
    if ("payload" in current && current.payload != null) {
      current = current.payload;
      continue;
    }

    if ("data" in current && current.data != null) {
      current = current.data;
      continue;
    }

    if ("result" in current && current.result != null) {
      current = current.result;
      continue;
    }

    break;
  }

  return current;
}

function extractList(payload) {
  const value = unwrap(payload);

  if (Array.isArray(value)) {
    return value;
  }

  if (!value || typeof value !== "object") {
    return [];
  }

  for (const key of ["list", "recorders", "items", "rows"]) {
    if (Array.isArray(value[key])) {
      return value[key];
    }
  }

  return [];
}

function extractRecorder(payload) {
  const value = unwrap(payload);

  if (
    !value ||
    typeof value !== "object" ||
    Array.isArray(value)
  ) {
    return null;
  }

  if (
    value.recorder &&
    typeof value.recorder === "object"
  ) {
    return value.recorder;
  }

  return value;
}

function isRecording(recorder) {
  return (
    recorder?.state === "recording" ||
    recorder?.recordStatus === "recording" ||
    recorder?.recording === true
  );
}

async function getDetail(item) {
  if (
    item &&
    typeof item === "object" &&
    Array.isArray(item.handleTime)
  ) {
    if (!detailLogged.has(item.id)) {
      detailLogged.add(item.id);
      log(
        `DETAIL id=${item.id} from=list ` +
        `provider=${item.providerId || ""} ` +
        `channel=${item.channelId || ""} ` +
        `handleTime=${JSON.stringify(item.handleTime)} ` +
        `state=${item.state || item.recordStatus || "unknown"}`,
      );
    }

    return item;
  }

  const id = item?.id;
  if (!id) return item;

  try {
    const payload = await api(
      `/recorder/${encodeURIComponent(id)}`,
    );

    const detail = extractRecorder(payload);

    // fnOS native8:
    // /recorder/list contains runtime state such as state=recording,
    // while /recorder/:id contains full config such as handleTime.
    // Merge them instead of letting detail overwrite/drop list state.
    const recorder = detail
      ? {
          ...item,
          ...detail,
          extra: {
            ...(item?.extra || {}),
            ...(detail?.extra || {}),
          },
          liveInfo:
            detail?.liveInfo ??
            item?.liveInfo,
        }
      : item;

    if (!detailLogged.has(id)) {
      detailLogged.add(id);
      log(
        `DETAIL id=${id} from=detail+list ` +
        `provider=${recorder?.providerId || ""} ` +
        `channel=${recorder?.channelId || ""} ` +
        `handleTime=${JSON.stringify(recorder?.handleTime)} ` +
        `state=${recorder?.state || recorder?.recordStatus || "unknown"} ` +
        `living=${recorder?.liveInfo?.living ?? "unknown"} ` +
        `tempStop=${recorder?.tempStopIntervalCheck === true}`,
      );
    }

    return recorder;
  } catch (error) {
    log(`DETAIL id=${id} error=${error.message}`);
    return item;
  }
}

async function tick() {
  if (busy) return;
  busy = true;

  try {
    const payload = await api(
      "/recorder/list?page=1&pageSize=1000",
    );

    const items = extractList(payload);

    if (!items.length) {
      log(
        "LIST returned no recorders; shape=" +
        JSON.stringify(payload).slice(0, 500),
      );
      return;
    }

    if (lastListCount !== items.length) {
      lastListCount = items.length;
      log(`LIST count=${items.length}`);
    }

    for (const item of items) {
      const recorder = await getDetail(item);
      const id = recorder?.id || item?.id;

      if (!id) continue;

      const range = recorder?.handleTime;
      const allowed = timeAllowed(range);

      // No configured monitor window -> leave this recorder untouched.
      if (allowed === null) {
        states.delete(id);
        continue;
      }

      let state = states.get(id);

      if (!state) {
        state = {
          inside: false,
          attempts: 0,
          lastAttempt: 0,
        };
        states.set(id, state);
      }

      if (!allowed) {
        if (state.inside) {
          log(
            `EXIT id=${id} ` +
            `provider=${recorder?.providerId || ""} ` +
            `channel=${recorder?.channelId || ""} ` +
            `handleTime=${JSON.stringify(range)}`,
          );
        }

        state.inside = false;
        state.attempts = 0;
        state.lastAttempt = 0;
        continue;
      }

      if (!state.inside) {
        state.inside = true;
        state.attempts = 0;
        state.lastAttempt = 0;

        log(
          `ENTER id=${id} ` +
          `provider=${recorder?.providerId || ""} ` +
          `channel=${recorder?.channelId || ""} ` +
          `handleTime=${JSON.stringify(range)} ` +
          `tempStop=${recorder?.tempStopIntervalCheck === true}`,
        );
      }

      if (recorder?.disableAutoCheck === true) {
        continue;
      }

      if (isRecording(recorder)) {
        if (state.attempts !== MAX_ATTEMPTS) {
          log(
            `ALREADY-RECORDING id=${id} ` +
            `state=${recorder?.state || recorder?.recordStatus || "recording"} ` +
            `handleTime=${JSON.stringify(range)}`,
          );
        }

        state.attempts = MAX_ATTEMPTS;
        continue;
      }

      const now = Date.now();

      if (
        state.attempts >= MAX_ATTEMPTS ||
        now - state.lastAttempt < RETRY_MS
      ) {
        continue;
      }

      state.attempts += 1;
      state.lastAttempt = now;

      log(
        `AUTO-START attempt=${state.attempts}/${MAX_ATTEMPTS} ` +
        `id=${id} ` +
        `state=${recorder?.state || recorder?.recordStatus || "unknown"} ` +
        `living=${recorder?.liveInfo?.living ?? "unknown"} ` +
        `tempStop=${recorder?.tempStopIntervalCheck === true}`,
      );

      try {
        const result = await api(
          `/recorder/${encodeURIComponent(id)}/start_record`,
          {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
            },
            body: "{}",
          },
        );

        log(
          `AUTO-START response id=${id} ` +
          JSON.stringify(result).slice(0, 800),
        );
      } catch (error) {
        log(
          `AUTO-START error id=${id} ` +
          error.message,
        );
      }
    }
  } catch (error) {
    log(`TICK error=${error.message}`);
  } finally {
    busy = false;
  }
}

log(`sidecar starting backend=${BASE}`);
void tick();

setInterval(() => {
  void tick();
}, POLL_MS);
NODE

  node --check "$RUNTIME/fnos_time_monitor.js"
}

runtime_diagnostics() {
  {
    echo "============================================================"
    echo "$(date '+%F %T') [fnOS native8] runtime diagnostics"
    echo "TZ=${TZ:-}"
    echo "date=$(date '+%F %T %z %Z' 2>/dev/null || date)"
    echo "node=$(node -v 2>/dev/null || echo missing)"
    echo "python=$(python3 --version 2>/dev/null || echo missing)"
    echo "runtime_version=$(cat "$RUNTIME/VERSION" 2>/dev/null || echo unknown)"
    echo "visible_log_dir=$LOG_DIR"
    echo "============================================================"
  } >> "$BACK_LOG" 2>&1
}

stop_one() {
  local f="$1" p="" n=0

  if pid_alive "$f"; then
    p="$(head -n1 "$f" | tr -d '[:space:]')"

    kill -TERM -- "-$p" 2>/dev/null \
      || kill -TERM "$p" 2>/dev/null \
      || true

    while kill -0 "$p" 2>/dev/null && [ "$n" -lt 15 ]; do
      sleep 1
      n=$((n + 1))
    done

    if kill -0 "$p" 2>/dev/null; then
      kill -KILL -- "-$p" 2>/dev/null \
        || kill -KILL "$p" 2>/dev/null \
        || true
    fi
  fi

  rm -f "$f"
}

start_app() {
  if is_running; then
    return 0
  fi

  stop_one "$FRONT_PID"
  stop_one "$TIME_PID"
  stop_one "$BACK_PID"

  repair_video_link || {
    echo "默认录像共享目录不可用。" > "${TRIM_TEMP_LOGFILE}"
    return 1
  }

  prepare_logs || {
    echo "无法创建 biliLive-tools-Logs 日志目录。" > "${TRIM_TEMP_LOGFILE}"
    return 1
  }

  [ -x "$RUNTIME/node/bin/node" ] || {
    echo "飞牛 Node.js 22 运行时不可用。" > "${TRIM_TEMP_LOGFILE}"
    return 1
  }

  [ -f "$RUNTIME/backend/ENTRY" ] || {
    echo "biliLive-tools 后端运行环境缺失，请重新安装/升级。" > "${TRIM_TEMP_LOGFILE}"
    return 1
  }

  [ -f "$RUNTIME/webui/index.html" ] || {
    echo "biliLive-tools WebUI 缺失，请重新安装/升级。" > "${TRIM_TEMP_LOGFILE}"
    return 1
  }

  [ -s "${TRIM_PKGETC}/passkey" ] || {
    echo "Web 管理密码不存在，请进入应用设置重新设置。" > "${TRIM_TEMP_LOGFILE}"
    return 1
  }

  echo "$(date '+%F %T') applying fnOS native8 stable strict-time patch" >> "$BACK_LOG"

  if [ ! -f "${TRIM_APPDEST}/native/BUILD.json" ]; then
    echo "biliLive-tools native8 核心时间段补丁失败，请在录像目录/biliLive-tools-Logs/backend.log 查看。" \
      > "${TRIM_TEMP_LOGFILE}"
    return 1
  fi

  if ! configure_visible_log >> "$BACK_LOG" 2>&1; then
    echo "biliLive-tools 可见日志配置失败，请查看 backend.log。" \
      > "${TRIM_TEMP_LOGFILE}"
    return 1
  fi

  runtime_diagnostics

  export BILILIVE_TOOLS_PASSKEY="$(cat "${TRIM_PKGETC}/passkey")"
  export BILILIVE_TOOLS_BILIKEY="$(cat "$RUNTIME/bilikey")"

  ENTRY="$(
    cat "$RUNTIME/backend/ENTRY" 2>/dev/null \
      | head -n1 \
      | tr -d '\r\n'
  )"

  case "$ENTRY" in
    /*) ;;
    *) ENTRY="$RUNTIME/backend/$ENTRY" ;;
  esac

  if [ ! -f "$ENTRY" ]; then
    ENTRY="$(
      find "$RUNTIME/backend/node_modules/bililive-cli" \
        -type f \
        -name index.cjs \
        -path '*/lib/*' \
        | head -n1 \
        || true
    )"
  fi

  [ -n "$ENTRY" ] && [ -f "$ENTRY" ] || {
    echo "找不到 bililive-cli 启动文件。" > "${TRIM_TEMP_LOGFILE}"
    return 1
  }

  mkdir -p "$RUNTIME/data" "$RUNTIME/home"
  cd "$RUNTIME" || return 1

  printf '%s starting backend\n' "$(date '+%F %T')" >> "$BACK_LOG"

  if command -v setsid >/dev/null 2>&1; then
    setsid node "$ENTRY" server \
      --config "$RUNTIME/config.json" \
      >> "$BACK_LOG" 2>&1 &
  else
    node "$ENTRY" server \
      --config "$RUNTIME/config.json" \
      >> "$BACK_LOG" 2>&1 &
  fi

  echo $! > "$BACK_PID"

  sleep 3

  if ! pid_alive "$BACK_PID"; then
    rm -f "$BACK_PID"
    echo "biliLive-tools 后端启动失败，请在录像目录/biliLive-tools-Logs/backend.log 查看。" \
      > "${TRIM_TEMP_LOGFILE}"
    return 1
  fi

  if ! prepare_time_sidecar >> "$BACK_LOG" 2>&1; then
    stop_one "$BACK_PID"
    echo "native6 定时监控 sidecar 生成失败，请查看 backend.log。" \
      > "${TRIM_TEMP_LOGFILE}"
    return 1
  fi

  export FNOS_BACKEND_URL="http://127.0.0.1:${BACK_PORT}"

  printf '%s starting native8 time sidecar\n' "$(date '+%F %T')" >> "$TIME_LOG"

  if command -v setsid >/dev/null 2>&1; then
    setsid node "$RUNTIME/fnos_time_monitor.js" \
      >> "$TIME_LOG" 2>&1 &
  else
    node "$RUNTIME/fnos_time_monitor.js" \
      >> "$TIME_LOG" 2>&1 &
  fi

  echo $! > "$TIME_PID"

  sleep 2

  if ! pid_alive "$TIME_PID"; then
    stop_one "$BACK_PID"
    echo "native6 定时监控 sidecar 启动失败，请查看 time-monitor.log。" \
      > "${TRIM_TEMP_LOGFILE}"
    return 1
  fi

  export FRONTEND_PORT="$FRONT_PORT"
  export BACKEND_PORT="$BACK_PORT"
  export BACKEND_HOST=127.0.0.1
  export WEB_ROOT="$RUNTIME/webui"

  printf '%s starting web wrapper\n' "$(date '+%F %T')" >> "$FRONT_LOG"

  if command -v setsid >/dev/null 2>&1; then
    setsid node "$RUNTIME/web_server.js" \
      >> "$FRONT_LOG" 2>&1 &
  else
    node "$RUNTIME/web_server.js" \
      >> "$FRONT_LOG" 2>&1 &
  fi

  echo $! > "$FRONT_PID"

  sleep 2

  if ! pid_alive "$FRONT_PID"; then
    stop_one "$TIME_PID"
    stop_one "$BACK_PID"
    echo "biliLive-tools WebUI 启动失败，请在录像目录/biliLive-tools-Logs/webui.log 查看。" \
      > "${TRIM_TEMP_LOGFILE}"
    return 1
  fi

  return 0
}

stop_app() {
  stop_one "$FRONT_PID"
  stop_one "$TIME_PID"
  stop_one "$BACK_PID"
  return 0
}

case "${1:-}" in
  start) start_app ;;
  stop) stop_app ;;
  status) if is_running; then exit 0; else exit 3; fi ;;
  *) echo "Unknown command: ${1:-}" > "${TRIM_TEMP_LOGFILE}"; exit 1 ;;
esac
