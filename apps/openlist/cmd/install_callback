#!/bin/bash
set -u
export PATH="/var/apps/python312/target/bin:/usr/local/bin:/usr/bin:/bin:$PATH"
RUNTIME="${TRIM_PKGVAR}/runtime"
DATA_DIR="${TRIM_PKGVAR}/data"
LOG="${TRIM_PKGVAR}/install.log"
VERSION="${TRIM_APPVER%%-*}"
mkdir -p "$RUNTIME" "$DATA_DIR" "${TRIM_PKGETC}"

if ! /var/apps/python312/target/bin/python3 "${TRIM_APPDEST}/native/bootstrap.py" \
  --runtime "$RUNTIME" --data "$DATA_DIR" --version "$VERSION" >> "$LOG" 2>&1; then
  {
    echo "OpenList 原生程序部署失败。"
    echo "install.log 最后 30 行："
    echo "----------------"
    tail -n 30 "$LOG" 2>/dev/null || true
  } > "${TRIM_TEMP_LOGFILE}"
  exit 1
fi

if [ -z "${openlist_password:-}" ]; then
  echo "没有收到 OpenList 管理员密码，请重新安装。" > "${TRIM_TEMP_LOGFILE}"
  exit 1
fi

cd "$RUNTIME" || exit 1
if ! "$RUNTIME/openlist" admin set "$openlist_password" >> "$LOG" 2>&1; then
  {
    echo "OpenList 管理员密码初始化失败。"
    echo "install.log 最后 30 行："
    echo "----------------"
    tail -n 30 "$LOG" 2>/dev/null || true
  } > "${TRIM_TEMP_LOGFILE}"
  exit 1
fi
exit 0
