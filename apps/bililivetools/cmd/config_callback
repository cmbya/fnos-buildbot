#!/bin/bash
set -euo pipefail
STATE_FILE="${TRIM_PKGVAR}/config_was_running"
PASS="${wizard_passkey:-}"
mkdir -p "${TRIM_PKGETC}"
if [ -n "$PASS" ]; then
  if [ "${#PASS}" -lt 6 ]; then
    echo "新管理密码至少需要 6 个字符。" > "${TRIM_TEMP_LOGFILE}"; exit 1
  fi
  umask 077
  printf '%s' "$PASS" > "${TRIM_PKGETC}/passkey"
  chmod 600 "${TRIM_PKGETC}/passkey" 2>/dev/null || true
fi
if [ ! -s "${TRIM_PKGETC}/passkey" ]; then
  echo "管理密码不存在，请设置一个至少 6 个字符的密码。" > "${TRIM_TEMP_LOGFILE}"; exit 1
fi
if [ -s "$STATE_FILE" ] && [ "$(head -n1 "$STATE_FILE" 2>/dev/null)" = "1" ]; then
  rm -f "$STATE_FILE"
  "$(dirname "$0")/main" start
else
  rm -f "$STATE_FILE"
fi
exit 0
